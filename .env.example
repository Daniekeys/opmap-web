# Copy to .env.local and fill in. Never commit .env files other than this one.

# Base URL of the opmap-api backend. Server-side only; the browser never sees it.
# Needed at build time as well as at run time: `next build` writes the /api/*
# rewrite into the build output.
API_URL=http://localhost:3000

# Shows the dev pages (the test job) in a production build. They are always on
# in `next dev`. The API needs ENABLE_DEV_ROUTES=true for them to work.
# ENABLE_DEV_PAGES=true
